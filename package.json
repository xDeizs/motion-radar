{
  "name": "motion-radar",
  "private": true,
  "version": "9.1.0",
  "description": "Motion Radar: LLM keyword research, public catalog metadata, private X intake and authored learning workflows.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "site": "python3 scripts/update.py --render-only",
    "update": "python3 scripts/update.py",
    "test": "python3 -m unittest discover -s tests -v",
    "analyze": "python3 scripts/enrich.py --backend transformers --fetch-articles --limit 4",
    "video": "node tools/render-led-wall.mjs",
    "topics": "python3 scripts/collect_topics.py",
    "watch:sources": "python3 scripts/watch_sources.py",
    "collect:library": "python3 scripts/collect_library.py",
    "collect:x": "python3 scripts/collect_x_learning.py"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "playwright": "1.63.0",
    "three": "0.171.0"
  }
}
